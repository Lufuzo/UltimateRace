@page
@using _SharedLayer.Models

@model UltimateRaceSolution.Pages.UltimateRace.IndexModel
@{
    ViewData["Title"] = "Ultimate Race";
}

    <h1>🚀 Ultimate Race – Live Dashboard</h1>
    <h2>Travel from Cairo to Cape Town.</h2>
    <h3></h3>

    <div style="margin-bottom:20px;">
        <button class="btn btn-success" onclick="startRace()">Start Race</button>
        <button class="btn btn-danger" onclick="resetRace()">Reset Race</button>
    </div>

    <div id="raceState" style="font-size: 1.5rem; font-weight: bold;"></div>

    <h2 id="winner" style="color: green;"></h2>

    <table class="table table-bordered" id="scoreTable">
        <thead>
            <tr>
                <th>Vehicle</th>
                <th>Distance (km)</th>
            </tr>
        </thead>
        <tbody>
        <tr><td>Bike</td><td id="bikeposition">0</td></tr>
        <tr><td>Tesla</td><td id="teslapostion">0</td></tr>
        <tr><td>Chopper</td><td id="chopperposition">0</td></tr>
        <tr><td>Nuclear Sub</td><td id="subposition">0</td></tr>
        </tbody>
    </table>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/racehub")
            .build();

             connection.on("ReceiveUpdate", function (sb) {
            document.getElementById("bikeposition").innerText = sb.bikeposition;
            document.getElementById("teslapostion").innerText = sb.teslapostion;
            document.getElementById("chopperposition").innerText = sb.chopperposition;
           document.getElementById("subposition").innerText = sb.subposition;

            document.getElementById("winner").innerText = sb.winner
                ? "🏆 Winner: " + sb.winner
                : "";
        });

        connection.on("RaceState", function (state) {
            if (state === "started")
                document.getElementById("raceState").innerText = "Race Started!";
            if (state === "reset")
                document.getElementById("raceState").innerText = "Race Reset!";
        });

        connection.start().catch(err => console.error(err));

        // Button functions
        function startRace() {
            connection.invoke("StartRace");
        }
        function resetRace() {
            connection.invoke("ResetRace");
        }
    </script>
    

